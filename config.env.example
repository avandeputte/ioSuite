# The machine's file: how this machine reaches the Shared ioSuite database, and what it runs. Copy it to config.env.
# Everything else is kept in the Shared ioSuite database: Settings › Apps › All settings, or `iosuite set`.

# ---- the Shared ioSuite database (every app's own database is on the same server, reached with the same login)
IOSUITE_DB_HOST=127.0.0.1
IOSUITE_DB_PORT=3306
IOSUITE_DB_NAME=iosuite
IOSUITE_DB_USER=iosuite
IOSUITE_DB_PASSWORD=

# ---- what this machine runs: app keys, commas between them (empty: every app installed)
# APPS=iostart,iocalendar,iotask,iocontact,ionote,iorecipe,iothings,iomoney,iodocs,iohealth,iodns,iobackup,iopix
APPS=

# ---- where it listens (HOST empty: every address of the machine; 127.0.0.1: behind a reverse proxy on this machine)
# HOST=
# PORT=80           the pages
# SYNC_PORT=8443    phones, native apps and devices (off: not opened)
# MCP_PORT=8444     MCP clients (off: not opened)

# ---- where the suite's other machines call this one (only when it cannot be told: in a container, say)
# INTERNAL_URL=http://192.168.1.151

# ---- HTTPS answered by the program itself instead of a reverse proxy. The suite asks for a certificate and renews
#      it (Settings › Servers › Certificate, or `iosuite cert --on`): nothing to set here for that
# HTTPS_PORT=443    the pages over HTTPS, opened once there is a certificate (off: this machine stays without HTTPS)
# ---- or a certificate of your own instead
# TLS_CERT_FILE=/etc/ssl/iosuite/fullchain.pem
# TLS_KEY_FILE=/etc/ssl/iosuite/privkey.pem
# ---- the root certificate of a private certificate authority the suite's certificate is asked from
# ACME_CA_FILE=/etc/ssl/my-root.pem

# ---- where the apps write on their own (<DATA_DIR>/<app>) and the one log (LOG_FILE=off: the journal only)
# DATA_DIR=/opt/iosuite/data
# LOG_FILE=/opt/iosuite/data/iosuite.log

# ---- the first admin, made on a first start with no accounts
# ADMIN_USER=
# ADMIN_PASSWORD=
