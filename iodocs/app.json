{
  "key": "iodocs",
  "name": "ioDocs",
  "description": "Passports, licenses and policies",
  "tag": "The family's papers",
  "color": "#a03a6a",
  "folder": "docs",
  "order": 85,
  "system": [
    "tesseract-ocr",
    "tesseract-ocr-eng",
    "poppler-utils"
  ],
  "compose": {
    "name": "docs",
    "what": "papers"
  },
  "items": [
    {
      "kind": "document",
      "label": "Document",
      "plural": "Documents",
      "href": "#/doc/{id}"
    }
  ],
  "notifications": [
    {
      "kind": "docs",
      "label": "Papers to renew",
      "hint": "In the morning, the passports, licenses and policies about to expire"
    }
  ],
  "start": {
    "rank": 55,
    "tile": true,
    "find": {
      "head": "Documents",
      "rank": 65
    },
    "searchUrl": "#/search/{q}"
  },
  "settings": [
    {
      "name": "MAX_FILE_MB",
      "label": "Largest file (MB)",
      "type": "number",
      "default": "100",
      "hint": "One scan, photo or PDF as uploaded."
    }
  ],
  "access": {
    "defaultRole": "none",
    "proxyExempt": [
      "/mcp"
    ]
  },
  "mcp": "Lets an AI assistant look up your documents and when they expire, and add them, as you.",
  "limits": {
    "json": 2,
    "file": {
      "setting": "MAX_FILE_MB",
      "default": 100
    }
  },
  "bodies": [
    {
      "path": "*/files",
      "limit": "file"
    }
  ]
}
