{
  "key": "iorecipe",
  "name": "ioRecipe",
  "description": "Recipes",
  "tag": "The family's recipes",
  "color": "#4a7c23",
  "page": {
    "search": "Search recipes…",
    "new": "New recipe"
  },
  "folder": "recipes",
  "devices": [
    "POST,DELETE /api/auth/device",
    "GET /api/auth/me",
    "GET /api/summary",
    "GET,POST /api/recipes",
    "GET,PATCH,DELETE /api/recipes/*",
    "POST /api/recipes/*/photos",
    "GET,DELETE /api/recipes/*/photos/*",
    "PUT /api/recipes/*/photos/order",
    "PUT /api/recipes/*/mark",
    "GET /api/books",
    "PUT,DELETE /api/books/*/recipes/*",
    "GET,POST /api/import",
    "POST /api/import/text",
    "POST /api/import/photo"
  ],
  "order": 60,
  "system": [
    "tesseract-ocr"
  ],
  "extras": [
    "iorecipe-ai"
  ],
  "compose": {
    "name": "recipes",
    "what": "recipes"
  },
  "start": {
    "find": {
      "head": "Recipes",
      "rank": 40
    },
    "searchUrl": "#/search/{q}"
  },
  "items": [
    {
      "kind": "recipe",
      "label": "Recipe",
      "plural": "Recipes",
      "href": "#/recipe/{id}"
    }
  ],
  "settings": [
    {
      "name": "AI",
      "label": "Read web pages without recipe data with AI",
      "type": "switch",
      "default": "1",
      "hint": "A small model that runs on this server, inside the app."
    },
    {
      "name": "AI_MODEL",
      "label": "AI model",
      "type": "text",
      "hint": "Another model than the one the app fetches: a GGUF file on the server, or the address of one."
    },
    {
      "name": "AI_TIMEOUT",
      "label": "AI: seconds one page may take",
      "type": "number",
      "default": "300",
      "hint": ""
    }
  ],
  "access": {
    "proxyExempt": [
      "/mcp"
    ]
  },
  "mcp": "Lets an AI assistant look recipes up, add them and import them from the web, as you.",
  "limits": {
    "json": 2,
    "import": 300,
    "photo": 20,
    "page": 5
  },
  "bodies": [
    {
      "path": "/api/import/file",
      "limit": "import"
    },
    {
      "path": "*/photos",
      "limit": "photo"
    },
    {
      "path": "*/import/photo",
      "limit": "photo"
    }
  ]
}
