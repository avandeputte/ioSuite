{
  "key": "ionote",
  "name": "ioNote",
  "description": "Notes",
  "tag": "Notes, clipboard snippets and screenshots",
  "color": "#1c5a5e",
  "folder": "notes",
  "devices": [
    "GET /api/status",
    "POST,DELETE /api/auth/device",
    "GET /api/auth/me",
    "GET /api/sync",
    "POST /api/sync/push",
    "GET,PUT /api/notes/*/image",
    "GET,PUT,DELETE /api/notes/*/attachments/*"
  ],
  "order": 30,
  "system": [
    "libheif1",
    "libglib2.0-0"
  ],
  "keepsOwn": [
    "workflow"
  ],
  "compose": {
    "name": "notes",
    "what": "notes"
  },
  "install": {
    "data": true
  },
  "start": {
    "rank": 70,
    "find": {
      "head": "Notes",
      "rank": 50
    },
    "searchUrl": "#/notes?q={q}"
  },
  "items": [
    {
      "kind": "note",
      "label": "Note",
      "plural": "Notes",
      "href": "#/note/{id}",
      "id": "uuid"
    }
  ],
  "settings": [
    {
      "name": "APP_NAME",
      "label": "What it calls itself",
      "type": "text",
      "default": "ioNote",
      "hint": "The name on its pages and in its notifications."
    },
    {
      "name": "MAX_IMAGE_MB",
      "label": "Largest image (MB)",
      "type": "number",
      "default": "15",
      "hint": "MariaDB's max_allowed_packet (16 MB by default) must be larger."
    },
    {
      "name": "THUMB_SIZE",
      "label": "Thumbnail size (pixels)",
      "type": "number",
      "default": "480",
      "hint": ""
    },
    {
      "name": "THUMB_QUALITY",
      "label": "Thumbnail quality",
      "type": "number",
      "default": "80",
      "hint": "JPEG quality, 1 to 95."
    }
  ],
  "access": {
    "writeRole": "member",
    "proxyExempt": [
      "/mcp"
    ]
  },
  "mcp": "Lets an AI assistant read, write and search your notes, as you.",
  "limits": {
    "json": 8,
    "import": 4096,
    "image": {
      "setting": "MAX_IMAGE_MB",
      "default": 16
    }
  },
  "bodies": [
    {
      "path": "*/api/import*",
      "limit": "import"
    },
    {
      "path": "*/attachments*",
      "limit": "image"
    },
    {
      "type": "image/*",
      "limit": "image"
    },
    {
      "type": "multipart/form-data",
      "limit": "image"
    },
    {
      "type": "application/octet-stream",
      "limit": "image"
    },
    {
      "type": "application/zip",
      "limit": "image"
    }
  ]
}
