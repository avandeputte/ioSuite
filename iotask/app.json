{
  "key": "iotask",
  "name": "ioTask",
  "description": "Tasks",
  "tag": "The family's task lists",
  "color": "#146b5e",
  "folder": "tasks",
  "sync": [
    "/dav",
    "/.well-known/"
  ],
  "homeOnly": [
    "/.well-known/"
  ],
  "order": 50,
  "compose": {
    "name": "tasks",
    "what": "tasks"
  },
  "start": {
    "rank": 40,
    "tile": true,
    "find": {
      "head": "Tasks",
      "rank": 30
    },
    "searchUrl": "#/search/{q}"
  },
  "items": [
    {
      "kind": "task",
      "label": "Task",
      "plural": "Tasks",
      "href": "#/task/{id}"
    }
  ],
  "notifications": [
    {
      "kind": "tasks",
      "label": "Tasks",
      "hint": "A task’s alert when it goes off, and in the morning what is due today"
    }
  ],
  "access": {
    "proxyExempt": [
      "/mcp",
      "/dav",
      "/.well-known/"
    ],
    "davScope": [
      "/dav",
      "/.well-known/caldav"
    ]
  },
  "mcp": "Lets an AI assistant read the lists, add tasks and tick them off, as you.",
  "limits": {
    "json": 2,
    "import": 16,
    "task": 1
  },
  "bodies": [
    {
      "path": "*/import*",
      "limit": "import"
    },
    {
      "path": "/dav*",
      "limit": "task"
    }
  ]
}
