{
  "key": "iopix",
  "name": "ioPix",
  "description": "Photos",
  "tag": "Photos",
  "color": "#3b4a8c",
  "folder": "pix",
  "media": [
    "/thumb/",
    "/preview/",
    "/face/",
    "/facecrop/",
    "/video/"
  ],
  "devices": [
    "POST,DELETE /api/auth/device",
    "GET /api/auth/me",
    "POST /api/auth/settings",
    "GET /api/badges",
    "GET /api/clothing",
    "GET /api/concepts",
    "GET /api/consistency",
    "POST /api/consistency/sync",
    "GET,POST /api/datehints",
    "GET /api/datesuggest",
    "GET /api/duplicates",
    "POST /api/edit",
    "POST /api/edit/revert",
    "GET,POST /api/edits/db",
    "GET /api/elevation",
    "GET /api/events",
    "GET /api/explore",
    "POST /api/faces/batch",
    "POST /api/faces/detect",
    "GET /api/faces/groups",
    "GET /api/faces/nearby",
    "POST /api/faces/op",
    "POST /api/faces/person",
    "GET /api/faces/queue",
    "GET /api/faces/summary",
    "GET /api/facets",
    "POST /api/favorites",
    "GET,POST /api/folders",
    "POST /api/folders/*/move",
    "POST /api/folders/*/properties",
    "POST /api/folders/*/rename",
    "POST /api/folders/*/upload",
    "GET /api/geocode",
    "POST /api/gpx/apply",
    "POST /api/gpx/preview",
    "GET /api/history",
    "POST /api/history/*/restore",
    "POST /api/import",
    "GET /api/import/*",
    "POST /api/import/*/discard",
    "POST /api/import/*/run",
    "POST /api/import/check",
    "GET /api/import/layouts",
    "POST /api/import/stage",
    "GET /api/jerseys",
    "POST /api/location/landmark",
    "GET /api/location/suggest",
    "GET /api/map",
    "GET /api/maps",
    "GET /api/meta",
    "GET,POST /api/metadata/*",
    "POST /api/metadata/*/reread",
    "GET /api/neardups",
    "POST /api/people/birth",
    "GET /api/people/birthdays",
    "GET,POST /api/people/groups",
    "POST,DELETE /api/people/groups/*",
    "POST /api/people/groups/order",
    "GET /api/photo/*",
    "GET /api/photos",
    "POST /api/photos/adjust",
    "POST /api/photos/crop",
    "POST /api/photos/move",
    "POST /api/photos/rename",
    "POST /api/photos/rename-pattern",
    "POST /api/photos/transform",
    "POST /api/photos/trash",
    "GET /api/photos/trash/*",
    "GET /api/placesuggest",
    "GET,POST /api/placetags",
    "GET /api/random",
    "GET /api/rotation",
    "POST /api/rotation/dismiss",
    "GET /api/scan",
    "POST /api/searches",
    "POST /api/searches/*",
    "GET /api/settings",
    "GET /api/state",
    "GET /api/status",
    "POST /api/suggestions/dismiss",
    "POST /api/tags/op",
    "POST /api/tags/recent",
    "GET /api/thenandnow",
    "GET /api/tools",
    "GET /api/trail",
    "GET /api/trash",
    "POST /api/trash/empty",
    "POST /api/trash/restore",
    "GET /api/trash/thumb",
    "POST /api/ualbums",
    "POST /api/ualbums/*",
    "GET,POST /api/zip",
    "POST /api/zip/plan"
  ],
  "order": 20,
  "system": [
    "libimage-exiftool-perl",
    "ffmpeg",
    "libjpeg-turbo-progs",
    "libheif1",
    "libglib2.0-0",
    "mariadb-client"
  ],
  "extras": [
    "iopix-ai",
    "iopix-captions",
    "iopix-speech"
  ],
  "apart": true,
  "heavy": true,
  "compose": {
    "name": "photos",
    "what": "photos"
  },
  "install": {
    "data": true,
    "extra": [
      "--no-digikam",
      "--features",
      "none"
    ],
    "photos": true,
    "launchd": "com.iopix"
  },
  "start": {
    "rank": 10,
    "tile": true,
    "find": {
      "head": "Photos",
      "rank": 80
    },
    "searchUrl": "#/photos?q={q}"
  },
  "items": [
    {
      "kind": "photo",
      "label": "Photo",
      "plural": "Photos",
      "href": "#/photos?p={id}"
    }
  ],
  "settings": [
    {
      "name": "PHOTOS_ROOT",
      "label": "Photos folder",
      "type": "text",
      "hint": "Where the photos are, when the library has a single album root. Empty: a folder named photos in the data folder."
    },
    {
      "name": "DIGIKAM_DB_TYPE",
      "label": "digiKam database",
      "type": "choice",
      "choices": [
        "none",
        "sqlite",
        "mysql"
      ],
      "default": "none",
      "hint": "none: no digiKam at all, ioPix keeps the library itself. sqlite: digikam4.db in the folder below. mysql: the server below."
    },
    {
      "name": "DIGIKAM_DB_DIR",
      "label": "Folder with digikam4.db",
      "type": "text"
    },
    {
      "name": "DIGIKAM_DB_HOST",
      "label": "digiKam MySQL host",
      "type": "text",
      "default": "127.0.0.1"
    },
    {
      "name": "DIGIKAM_DB_PORT",
      "label": "digiKam MySQL port",
      "type": "number",
      "default": "3306"
    },
    {
      "name": "DIGIKAM_DB_NAME",
      "label": "digiKam MySQL database",
      "type": "text",
      "default": "digikam"
    },
    {
      "name": "DIGIKAM_DB_USER",
      "label": "digiKam MySQL user",
      "type": "text",
      "default": "digikam",
      "hint": "Its password is set in ioPix under Settings › Library › digiKam database."
    },
    {
      "name": "DIGIKAM_DB_BACKUP",
      "label": "Back up digiKam's database before destructive operations",
      "type": "choice",
      "choices": [
        "auto",
        "skip"
      ],
      "default": "auto"
    },
    {
      "name": "DIGIKAM_DB_DUMP",
      "label": "Command that dumps digiKam's MySQL database",
      "type": "text",
      "hint": "Used instead of mysqldump, e.g. through docker exec."
    },
    {
      "name": "DIGIKAM_CHECK",
      "label": "How to tell that digiKam is closed",
      "type": "choice",
      "choices": [
        "pgrep",
        "none"
      ],
      "default": "pgrep",
      "hint": "none: digiKam runs on another machine and cannot be seen."
    },
    {
      "name": "DIGIKAM_MYSQL_DATES",
      "label": "Dates in a MySQL digiKam library",
      "type": "choice",
      "choices": [
        "",
        "utc",
        "local"
      ],
      "hint": "Empty: detected."
    },
    {
      "name": "SIDECAR_COMPAT",
      "label": "Name new sidecars photo.xmp",
      "type": "switch",
      "default": "0"
    },
    {
      "name": "EDITING",
      "label": "Allow metadata edits",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "DB_WRITE",
      "label": "Allow “Apply to digiKam database”",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "PREWARM",
      "label": "Build all grid thumbnails in the background",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "SEMANTIC",
      "label": "Search by content",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "ANALYSIS",
      "label": "Analyse photos in the background",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "CAPTIONS",
      "label": "Describe every photo in a sentence",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "AUTO_MODELS",
      "label": "Models to download when missing",
      "type": "text",
      "hint": "For example siglip2,yolox,geonames."
    },
    {
      "name": "BG_THREADS",
      "label": "Cores a background job may use",
      "type": "number",
      "hint": "Empty: half the machine."
    },
    {
      "name": "PREWARM_WORKERS",
      "label": "Threads for thumbnails",
      "type": "number",
      "hint": "Empty: the cores above."
    },
    {
      "name": "ANALYSIS_WORKERS",
      "label": "Threads for analysis",
      "type": "number",
      "hint": "Empty: the cores above."
    },
    {
      "name": "JOBS_PROCESS",
      "label": "Run AI jobs in a process of their own",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "JOBS_MEMORY_MB",
      "label": "Most memory the job process may hold (MB)",
      "type": "number",
      "hint": "Empty: 60% of the machine's. 0: no limit."
    },
    {
      "name": "MEMORY_RESERVE_MB",
      "label": "Free memory the server keeps (MB)",
      "type": "number",
      "hint": "Empty: 8% of the machine's."
    },
    {
      "name": "THUMB_HEIGHT",
      "label": "Thumbnail height",
      "type": "number",
      "default": "360"
    },
    {
      "name": "THUMB_MAX_WIDTH",
      "label": "Thumbnail width at most",
      "type": "number",
      "default": "1080"
    },
    {
      "name": "THUMB_QUALITY",
      "label": "Thumbnail quality",
      "type": "number",
      "default": "76"
    },
    {
      "name": "PREVIEW_SIZE",
      "label": "Preview size (longest edge)",
      "type": "number",
      "default": "2560"
    },
    {
      "name": "PREVIEW_QUALITY",
      "label": "Preview quality",
      "type": "number",
      "default": "86"
    },
    {
      "name": "PREVIEW_CACHE_MAX_MB",
      "label": "Preview cache at most (MB)",
      "type": "number",
      "default": "8000"
    },
    {
      "name": "VARIANT_CACHE_MAX_MB",
      "label": "Cut-down thumbnails cache at most (MB)",
      "type": "number",
      "default": "2000"
    },
    {
      "name": "REINDEX_POLL",
      "label": "Seconds between checks of digiKam's database",
      "type": "number",
      "default": "20"
    },
    {
      "name": "INDEX_PATCH",
      "label": "Update the search index in place after small changes",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "SCANNER_LOOP",
      "label": "File scanner runs by itself",
      "type": "switch",
      "default": "1"
    },
    {
      "name": "EXIFTOOL",
      "label": "exiftool to use",
      "type": "text",
      "hint": "Empty: the one on the PATH."
    }
  ],
  "ask": [
    {
      "name": "PHOTOS_ROOT",
      "option": "photos",
      "question": "ioPix: the folder with the photos (empty: a new, empty one in the data folder)"
    },
    {
      "name": "DIGIKAM_DB_DIR",
      "option": "digikam",
      "question": "ioPix: the folder with digiKam's digikam4.db (empty: no digiKam, ioPix keeps the library itself)",
      "also": {
        "DIGIKAM_DB_TYPE": "sqlite"
      }
    }
  ]
}
