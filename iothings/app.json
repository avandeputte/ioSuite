{
  "key": "iothings",
  "name": "ioThings",
  "description": "Everything you own",
  "tag": "Everything you own",
  "color": "#2a6f97",
  "page": {
    "search": "Search things…",
    "new": "New thing"
  },
  "folder": "things",
  "order": 70,
  "system": [
    "fonts-dejavu-core"
  ],
  "compose": {
    "name": "things",
    "what": "inventory"
  },
  "start": {
    "find": {
      "head": "Things",
      "rank": 60
    },
    "searchUrl": "#/search/{q}"
  },
  "items": [
    {
      "kind": "item",
      "label": "Thing",
      "plural": "Things",
      "href": "#/item/{id}"
    }
  ],
  "notifications": [
    {
      "kind": "things",
      "label": "Upkeep and warranties",
      "hint": "In the morning, the upkeep that is due and the warranties about to end"
    }
  ],
  "settings": [
    {
      "name": "MAX_FILE_MB",
      "label": "Largest attachment (MB)",
      "type": "number",
      "default": "100",
      "hint": "One manual, receipt or photo as uploaded."
    },
    {
      "name": "CURRENCY",
      "label": "Currency",
      "type": "choice",
      "default": "USD",
      "hint": "Prices are kept as plain amounts: changing the currency changes how they show, not what they are.",
      "choices": [
        "USD",
        "EUR",
        "GBP",
        "CHF",
        "CAD",
        "AUD",
        "NZD",
        "SEK",
        "NOK",
        "DKK",
        "PLN",
        "CZK",
        "JPY",
        "INR",
        "ZAR",
        "BRL",
        "MXN"
      ]
    }
  ],
  "access": {
    "proxyExempt": [
      "/mcp"
    ]
  },
  "mcp": "Lets an AI assistant look things up, add them and log their upkeep, as you.",
  "limits": {
    "json": 2,
    "import": 20,
    "file": {
      "setting": "MAX_FILE_MB",
      "default": 100
    }
  },
  "bodies": [
    {
      "path": "/api/import/homebox",
      "limit": "import"
    },
    {
      "path": "*/files",
      "limit": "file"
    }
  ]
}
